NODE_ENV=development
PORT=9001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:9001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cheda?schema=public

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=30

# When false, no OTP emails are sent and every OTP is 424242. Must be true in production.
OTP_EMAIL_ENABLED=false

# ZeptoMail (https://www.zoho.com/zeptomail). Leave ZEPTOMAIL_TOKEN empty in dev to log emails to the console.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@cheda.app
ZEPTOMAIL_FROM_NAME=Cheda

# Firebase Admin service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (or any S3-compatible store). R2 > Manage API Tokens for the keys. Private bucket holds product files and HLS segments; public bucket holds logos, covers and avatars.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRIVATE_BUCKET=
STORAGE_PUBLIC_BUCKET=
# Public URL prefix of the public bucket, e.g. https://pub-<id>.r2.dev (dev only, rate-limited) or a custom domain
STORAGE_PUBLIC_URL=

# Paystack (Settings > API Keys & Webhooks) bills Pro/Premium plans. Plans are created on Paystack automatically.
# Webhook URL: <API_URL>/api/webhooks/paystack (Paystack signs webhooks with the secret key itself).
PAYSTACK_SECRET_KEY=

# Bachs (Developer Portal > API keys) collects product sales. sk_sandbox_ keys use the sandbox, sk_live_ keys production.
# Webhook URL: <API_URL>/api/webhooks/bachs, events checkout.completed, collection.succeeded, checkout.expired.
# BACHS_WEBHOOK_SECRET is that endpoint's signing secret (whsec_...).
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# Admin account created by `pnpm run seed:admin` (runs on the admin. subdomain of the frontend)
ADMIN_EMAIL=admin@cheda.app
ADMIN_PASSWORD=
